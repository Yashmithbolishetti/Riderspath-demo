# ==========================================
# RIDERS PATH — ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Gemini AI API Key (Required for AI Vision Document Verification)
# On AI Studio: automatically injected from your user secrets.
# On Vercel: Add this in Vercel Dashboard -> Project Settings -> Environment Variables.
GEMINI_API_KEY=""

# 2. Application URL (Optional)
# The public URL of the deployed application (e.g. https://your-project.vercel.app).
APP_URL=""

# 3. Email Gateway (Optional - for dispatching real renter confirmation emails)
# If left unset, communications are saved to the administrative audit log.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-campus-email@gmail.com"
# SMTP_PASS="your-app-password"
# RESEND_API_KEY="re_..."

# 4. WhatsApp Gateway (Optional - for automated direct WhatsApp dispatch)
# If left unset, a one-click manual WhatsApp web link is generated.
# WHATSAPP_API_KEY=""
